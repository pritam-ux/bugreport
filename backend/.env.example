# Copy to .env. scripts/setup.ps1 does this for you and generates JWT_SECRET.

ENVIRONMENT=development
MONGODB_URI=mongodb://localhost:27018
MONGODB_DB=bugsense_ai

# Required, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Returns the password reset link in the API response, because no mail service
# is configured. Always off when ENVIRONMENT=production.
EXPOSE_RESET_TOKEN=true
